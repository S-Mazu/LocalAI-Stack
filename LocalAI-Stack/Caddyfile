# Caddyfile — reverse proxy
#
# Purpose: every container becomes reachable under its own name instead of
# under localhost with a port number. http://localhost:3000 becomes
# http://chat.ai.internal
#
# How it fits together:
#   1. The Windows hosts file points the names at 127.0.0.1
#   2. There this proxy accepts the request on port 80
#   3. From the name in the request it picks the matching container
#
# Structure of a block:
#   http://<name>            what the proxy listens for
#   reverse_proxy <target>   where it forwards to, container name plus port
#
# The http:// prefix is mandatory: without it Caddy tries to obtain an HTTPS
# certificate for every name. That fails for local names.


# Chat interface (Open WebUI)
# The target is port 8080 because that is what the container listens on
# internally. The 3000:8080 mapping from docker-compose.yml does not apply here.
http://chat.ai.internal {
	reverse_proxy chat:8080
}

# Workflow automation (n8n)
http://automation.ai.internal {
	reverse_proxy automation:5678
}

# MCP tools (mcpo)
# The tool list is at http://tools.ai.internal/docs
http://tools.ai.internal {
	reverse_proxy tools:8000
}

# Document extraction (Docling)
http://extraction.ai.internal {
	reverse_proxy extraction:5001
}

# Language models (Ollama)
http://inference.ai.internal {
	reverse_proxy inference:11434
}

# --- Optional: Portainer (README 5.2) ---
